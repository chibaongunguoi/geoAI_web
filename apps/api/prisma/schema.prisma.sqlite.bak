generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  email        String     @unique
  name         String
  passwordHash String
  status       String     @default("ACTIVE")
  roles        UserRole[]
  sessions     Session[]
  auditLogs    AuditLog[]
  layerConfig  LayerUserConfig?
  assetDisplayConfig AssetDisplayUserConfig?
  reports      Report[]
  notifications Notification[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  group       String
  name        String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
}

model LayerUserConfig {
  userId    String   @id
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BuildingProperty {
  id                   String    @id @default(cuid())
  code                 String    @unique
  overtureId           String?   @unique
  name                 String?
  addressLine          String?
  street               String?
  ward                 String?
  district             String?
  city                 String    @default("Da Nang")
  propertyType         String    @default("building")
  status               String    @default("ACTIVE")
  source               String    @default("manual")
  sourceVersion        String?
  level                Float?
  height               Float?
  floors               Int?
  areaSqm              Float?
  centroidLat          Float?
  centroidLng          Float?
  bbox                 Json?
  geometry             Json?
  attributes           Json?
  searchText           String    @default("")
  searchTextNormalized String    @default("")
  embedding            Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([city, district, ward])
  @@index([street])
  @@index([status])
  @@index([source, overtureId])
  @@index([deletedAt])
  @@index([searchTextNormalized])
  @@index([propertyType])
  @@index([propertyType, centroidLat, centroidLng])
}

model Place {
  id            String   @id @default(cuid())
  overtureId    String   @unique
  name          String
  category      String
  subcategories Json     @default("[]")
  address       String?
  street        String?
  ward          String?
  district      String?
  city          String   @default("Da Nang")
  latitude      Float
  longitude     Float
  geometry      Json
  confidence    Float    @default(0)
  source        String   @default("overture-places")
  sourceVersion String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([city, district, ward])
}

model AssetDisplayUserConfig {
  userId    String   @id
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id              String   @id @default(cuid())
  userId          String
  reason          String
  message         String
  latitude        Float
  longitude       Float
  status          String   @default("PENDING") // PENDING, RECEIVED, RESPONDED, RESOLVED
  responseMessage String?
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   // e.g., "REPORT_NEW", "REPORT_RECEIVED", "REPORT_RESPONDED", "REPORT_RESOLVED"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
